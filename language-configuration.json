{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "!", "close": "!" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "!", "close": "!" },
    { "open": "\"", "close": "\"" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(IFB(?!\\s+end)|LOP(?!\\s+end)|WHN(?!\\s+end))\\b.*$",
    "decreaseIndentPattern": "^\\s*(IFB\\s+(els|end)|LOP\\s+end|WHN\\s+end)\\b.*$"
  }
}
